<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven POM (Project Object Model) - Arquivo de configuração do projeto
  Define dependências, versões, plugins e configurações de build
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    
    <!-- Coordenadas do projeto: grupo, artefato e versão -->
    <modelVersion>4.0.0</modelVersion>
    
    <!-- groupId: Identificador único do grupo/organização (reverso do domínio) -->
    <groupId>br.org.cdlbh</groupId>
    
    <!-- artifactId: Nome do projeto/artefato -->
    <artifactId>fornecedores-backend</artifactId>
    
    <!-- version: Versão do projeto (SNAPSHOT indica versão em desenvolvimento) -->
    <version>1.0.0-SNAPSHOT</version>
    
    <!-- name: Nome legível do projeto -->
    <name>Sistema de Gestão de Fornecedores - Backend Java</name>
    
    <!-- description: Descrição do projeto -->
    <description>Backend em Spring Boot para o Sistema de Gestão de Fornecedores da Fundação CDL-BH</description>

    <!-- Parent: Herda configurações do Spring Boot Starter Parent -->
    <!-- Isso simplifica muito a configuração, pois o parent já define versões compatíveis -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <!-- Propriedades do projeto -->
    <properties>
        <!-- Java version: Define que o projeto usa Java 17 -->
        <java.version>17</java.version>
        
        <!-- Encoding: Define UTF-8 como codificação padrão para evitar problemas com acentuação -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <!-- Dependências do projeto -->
    <dependencies>
        <!-- 
            spring-boot-starter-web
            Fornece tudo necessário para criar aplicações web REST:
            - Spring MVC (para controllers REST)
            - Tomcat embutido (servidor web)
            - Jackson (para serialização/deserialização JSON)
            - Validação (Bean Validation)
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 
            spring-boot-starter-data-jpa
            Fornece integração com Spring Data JPA:
            - Hibernate (implementação JPA)
            - Repositórios Spring Data (interface para CRUD sem SQL manual)
            - Transações automáticas
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- 
            spring-boot-starter-security
            Fornece segurança da aplicação:
            - Autenticação e autorização
            - Proteção contra CSRF, XSS, etc.
            - Suporte a JWT (com configuração adicional)
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- 
            spring-boot-starter-validation
            Fornece Bean Validation (JSR-380):
            - Anotações como @NotNull, @Size, @Email, @Pattern
            - Validação automática nos DTOs
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 
            mysql-connector-j
            Driver JDBC oficial do MySQL para Java
            Necessário para conectar o Spring Boot ao banco MySQL
        -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 
            jjwt (JSON Web Token)
            Biblioteca para criar e validar tokens JWT
            Usada para autenticação stateless via tokens
        -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.3</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.3</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.3</version>
            <scope>runtime</scope>
        </dependency>

        <!-- 
            bucket4j-core
            Biblioteca para rate limiting (limitação de taxa)
            Usada para implementar o limite de 5 tentativas de login em 15 minutos
        -->
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j-core</artifactId>
            <version>8.7.0</version>
        </dependency>

        <!-- 
            Lombok
            Biblioteca que reduz código repetitivo via anotações:
            - @Getter/@Setter: gera getters e setters automaticamente
            - @NoArgsConstructor/@AllArgsConstructor: gera construtores
            - @Data: gera getters, setters, toString, equals, hashCode
            NOTA: Como você está aprendendo, usarei Lombok com moderação
            e explicarei cada anotação no código
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 
            spring-boot-starter-test
            Fornece ferramentas para testes:
            - JUnit 5 (framework de testes)
            - Mockito (mocking)
            - Spring Boot Test (contexto Spring para testes)
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 
            spring-security-test
            Fornece suporte para testar configurações de segurança
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- Build configuration -->
    <build>
        <plugins>
            <!-- 
                spring-boot-maven-plugin
                Plugin do Maven que empacota a aplicação como JAR executável
                Inclui todas as dependências necessárias dentro do JAR
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- 
                        exclude: Configuração para não incluir Lombok no JAR final
                        Lombok é usado apenas em tempo de compilação
                    -->
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
